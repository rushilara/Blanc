{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blanc AnalysisRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "case_id",
    "question",
    "excluded_record_ids",
    "retrieved_record_ids",
    "answer",
    "claims",
    "graph",
    "timeline_events",
    "unresolved_questions",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_analysis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "excluded_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "retrieved_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "answer": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "evidence_ids",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "reported",
              "inferred",
              "unresolved"
            ]
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "person",
                  "account",
                  "device",
                  "location",
                  "organization",
                  "document",
                  "other"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target",
              "type",
              "evidence_ids",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "observed",
                  "reported",
                  "inferred"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "timeline_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "timestamp",
          "evidence_ids",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": [
              "string",
              "null"
            ]
          },
          "timestamp_precision": {
            "type": "string",
            "enum": [
              "exact",
              "day",
              "month",
              "approximate",
              "unknown"
            ]
          },
          "timestamp_kind": {
            "type": "string",
            "enum": [
              "observed",
              "source_stated",
              "inferred",
              "unknown"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "reported",
              "inferred"
            ]
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_review": {
      "type": "boolean",
      "description": "Set by the server when LLM output still failed schema/source validation after one retry and this revision holds a partial result for investigator review. Absent or false means validation passed."
    },
    "validation_errors": {
      "type": "array",
      "description": "Server-generated validation messages explaining why needs_review is set. Never LLM-authored.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retrieval_coverage": {
      "type": "object",
      "description": "Server-assigned record of what the evidence window held back (BLA-64). Never LLM-produced. Absent on revisions saved before it existed; treat those as the standard window with no offer.",
      "additionalProperties": false,
      "required": [
        "evidence_window",
        "max_records",
        "max_excerpt_chars",
        "skipped",
        "budget_substituted",
        "left_out_record_ids",
        "offer_expanded_window"
      ],
      "properties": {
        "evidence_window": {
          "type": "string",
          "enum": [
            "standard",
            "expanded"
          ]
        },
        "max_records": {
          "type": "integer",
          "minimum": 1
        },
        "max_excerpt_chars": {
          "type": "integer",
          "minimum": 1
        },
        "skipped": {
          "type": "array",
          "description": "Every ranked candidate left out of the window, in rank order. IDs only, never content; not citations.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "rank",
              "reason"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "budget",
                  "record_limit",
                  "media",
                  "media_limit",
                  "media_too_large"
                ],
                "description": "budget: did not fit the character budget. record_limit: ranked past max_records. The media reasons mark an image/PDF record in the window that was not sent to the model: media_limit: over a media count or total-bytes cap; media_too_large: the single file is over the per-file inline cap; media: any other reason (stored file missing or failed its integrity check), and on revisions saved before vision analysis, any retrieved media."
              },
              "vector_rank": {
                "type": "integer",
                "minimum": 1
              },
              "keyword_rank": {
                "type": "integer",
                "minimum": 1
              },
              "modality": {
                "type": "string",
                "enum": [
                  "image",
                  "pdf"
                ],
                "description": "Set for image/PDF records; absent means text."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "reason": {
                      "enum": [
                        "media",
                        "media_limit",
                        "media_too_large"
                      ]
                    }
                  },
                  "required": [
                    "reason"
                  ]
                },
                "then": {
                  "required": [
                    "modality"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "reason": {
                      "const": "budget"
                    }
                  },
                  "required": [
                    "reason"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "modality"
                    ]
                  }
                }
              }
            ]
          }
        },
        "budget_substituted": {
          "type": "boolean"
        },
        "left_out_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "description": "Text record_limit skips that the vector or keyword search alone ranked within max_records, in rank order. Image/PDF skips never count.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "offer_expanded_window": {
          "type": "boolean",
          "description": "True when evidence_window is standard and left_out_record_ids is non-empty."
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
