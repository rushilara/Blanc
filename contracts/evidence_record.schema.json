{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blanc EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "case_id",
    "source_file",
    "source_locator",
    "content"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp_kind": {
      "type": "string",
      "enum": [
        "sent",
        "received",
        "created",
        "modified",
        "observed",
        "stated",
        "unknown"
      ]
    },
    "original_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}
