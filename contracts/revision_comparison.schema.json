{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blanc RevisionComparison",
  "description": "Compares a base AnalysisRevision with a child revision produced by excluding evidence. Describes what the analysis can still conclude, not what happened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "base_analysis_id",
    "compared_analysis_id",
    "excluded_record_ids",
    "items",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "base_analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "compared_analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "excluded_record_ids": {
      "type": "array",
      "description": "Records excluded in the compared revision but not in the base revision.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "base_ref_id",
          "compared_ref_id",
          "support_status",
          "base_evidence_ids",
          "compared_evidence_ids"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "base_ref_id": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "base_evidence_ids": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "compared_ref_id": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "compared_evidence_ids": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "base_ref_id": {
                  "type": "string"
                },
                "compared_ref_id": {
                  "type": "string"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "possible_matches"
                ]
              }
            }
          }
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "edge",
              "event"
            ]
          },
          "base_ref_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Item ID in the base revision; null when the item only exists in the compared revision."
          },
          "compared_ref_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Item ID in the compared revision; null when no matching item survives."
          },
          "support_status": {
            "type": "string",
            "enum": [
              "still_supported",
              "weakened",
              "not_supported",
              "newly_supported",
              "unresolved"
            ]
          },
          "base_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "compared_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "explanation": {
            "type": "string",
            "description": "Cautious, source-referenced wording, e.g. 'no longer supported by the remaining evidence', never 'did not happen'."
          },
          "possible_matches": {
            "type": "array",
            "description": "Advisory and server-computed, never LLM-generated: findings on the other side that are possibly the same finding. Set only on items without an identity match: on a base-only item (compared_ref_id null) each ref_id is the compared_ref_id of a newly_supported item; on a newly_supported item (base_ref_id null) each ref_id is the base_ref_id of an unresolved or not_supported item. Links are listed on both items. A link means every record the newly supported finding cites was cited by the base finding and is still permitted (edges also need the same endpoint entities). It never changes support_status; the investigator must confirm. Omitted when there are none and never present when both ref IDs are set. Ordered by number of shared records (most first), then ref_id.",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref_id",
                "shared_evidence_ids",
                "remaining_sources",
                "original_sources"
              ],
              "properties": {
                "ref_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Item ID on the other side of the comparison (see possible_matches)."
                },
                "shared_evidence_ids": {
                  "type": "array",
                  "description": "Records cited by both findings, each once.",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "remaining_sources": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "How many of the base finding's unique cited records are still permitted: N in 'N of M cited sources remain'."
                },
                "original_sources": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "How many unique records the base finding cited: M in 'N of M cited sources remain'."
                }
              }
            }
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
