# Copy to .env and fill in locally. Never commit real secrets.
# Demo: cp .env.example .env → set GEMINI_API_KEY → make backend / make frontend
# → open http://localhost:3000. Case storage stays local (see DATABASE_URL).
# Keys are optional at startup: the backend runs and /health works without them.
# GEMINI_API_KEY is required for make import (embeddings) and for asking questions (LLM).

# Google Gemini API (https://aistudio.google.com/apikey), used for the LLM and embeddings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Embeddings: Gemini embeddings. EMBEDDING_DIM is the output_dimensionality and the
# vector index dimension; after changing either, stored chunks need re-embedding.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Storage (local-first): one SQLite file holds records, chunks, the sqlite-vec
# vector index and the FTS5 keyword index. Relative paths resolve from backend/,
# where uvicorn runs. Keep this on the investigator's machine for MVP — do not
# point it at a hosted Railway/Render volume for case evidence.
DATABASE_URL=sqlite:///./data/blanc.db

# Optional: local folder of files extracted from the case image (e.g. data/narcos), so the
# workspace can show a record's original image. Relative paths resolve from backend/.
# Layout is per case: EVIDENCE_ROOT/{case_id}/ holds that case's extracted files and its
# artifact_manifest.jsonl (source_path, extracted_file, sha256, optional record_ids).
# Leave empty to show no images. Never a URL: images are only read from local disk.
EVIDENCE_ROOT=

# Case-local media bytes from import (BLA-68 / PR #67): images/PDFs copied on import to
# {CASES_DIR}/{case_id}/media/{record_id}.ext. Distinct from EVIDENCE_ROOT above (extracted
# originals). Serving those imported files via GET .../media is a follow-up once #67 lands.
# Relative paths resolve from backend/. Override with --media-dir on
# python -m app.evidence.
# CASES_DIR=./data/cases

# Retrieval tuning (optional; defaults shown). Per-machine override — leave at the
# defaults unless the team agrees otherwise. Out-of-range values stop the backend
# at startup. Changes need a backend restart (config is read once in main.py).
#
# Evidence window (what the model gets to read per question):
#   RETRIEVAL_MAX_RECORDS (1–200): at most this many records.
#   RETRIEVAL_MAX_EXCERPT_CHARS (≥1): character budget for excerpt text (~4 chars/token).
#   RETRIEVAL_MAX_EXCERPTS_PER_RECORD (≥1): best excerpts kept per record.
# The character budget still caps the window, so raising MAX_RECORDS only adds text
# when the budget is not already full. The `skipped` list on
# POST /cases/{case_id}/search shows whether the record cap or the character budget
# limited the window.
#
# Candidates + fusion (chunks pulled from each index, then fused):
#   RETRIEVAL_VECTOR_CANDIDATES / RETRIEVAL_KEYWORD_CANDIDATES (1–4096 each):
#     chunks pulled from the vector / keyword index per question.
#   RETRIEVAL_RRF_K (≥0) and RETRIEVAL_VECTOR_WEIGHT / RETRIEVAL_KEYWORD_WEIGHT (≥0):
#     reciprocal rank fusion score = sum(weight / (RRF_K + rank)).
# RETRIEVAL_MAX_RECORDS=16
# RETRIEVAL_MAX_EXCERPT_CHARS=32000
# RETRIEVAL_MAX_EXCERPTS_PER_RECORD=2
# RETRIEVAL_VECTOR_CANDIDATES=50
# RETRIEVAL_KEYWORD_CANDIDATES=50
# RETRIEVAL_RRF_K=60
# RETRIEVAL_VECTOR_WEIGHT=1.0
# RETRIEVAL_KEYWORD_WEIGHT=1.0
#
# "Want more evidence?" (BLA-64). The standard window is RETRIEVAL_MAX_RECORDS;
# the expanded window, which the investigator opts into per question, raises only
# the record count (same character budget). Must be larger than
# RETRIEVAL_MAX_RECORDS (2–200), or the backend will not start.
# RETRIEVAL_EXPANDED_MAX_RECORDS=24

# Hosted app path (BLA-61, docs/06_DEPLOYMENT.md). Set to 1 only on a public frontend
# deploy: it closes /workspace, /live and /sample (landing page only) until auth exists.
# Leave unset for local runs.
# BLANC_HOSTED=1

# Backend server
BACKEND_PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
